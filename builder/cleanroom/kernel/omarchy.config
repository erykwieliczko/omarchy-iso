# Distribution requirements layered over the accepted J713 hardware config.
CONFIG_LOCALVERSION="-omarchy-mac.1"
# CONFIG_LOCALVERSION_AUTO is not set
CONFIG_MODULES=y
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y
CONFIG_RUST=y
CONFIG_BLK_DEV_NVME=y
CONFIG_BTRFS_FS=y
CONFIG_EXT4_FS=y
CONFIG_APPLE_DART=y
CONFIG_APPLE_SART=y
CONFIG_APPLE_PMP_THERMAL=m
CONFIG_BRCMFMAC=y
CONFIG_BRCMFMAC_PCIE=y

# iwd's AF_ALG interfaces and WPA/EAP crypto primitives.
CONFIG_NET=y
CONFIG_KEYS=y
CONFIG_KEY_DH_OPERATIONS=y
CONFIG_CRYPTO_USER_API_HASH=y
CONFIG_CRYPTO_USER_API_SKCIPHER=y
CONFIG_CRYPTO_AES=y
CONFIG_CRYPTO_DES=m
CONFIG_CRYPTO_ECB=y
CONFIG_CRYPTO_CBC=m
CONFIG_CRYPTO_HMAC=m
CONFIG_CRYPTO_CMAC=m
CONFIG_CRYPTO_MD5=m
CONFIG_CRYPTO_SHA1=m
CONFIG_CRYPTO_SHA256=y
CONFIG_CRYPTO_SHA512=m

# UFW's IPv4/IPv6 iptables-nft rules and match extensions.
CONFIG_INET=y
CONFIG_IPV6=y
CONFIG_NETFILTER=y
CONFIG_NETFILTER_ADVANCED=y
CONFIG_NETFILTER_XTABLES=m
CONFIG_NF_CONNTRACK=m
CONFIG_NF_LOG_SYSLOG=m
CONFIG_NF_TABLES=m
CONFIG_NF_TABLES_IPV4=y
CONFIG_NF_TABLES_IPV6=y
CONFIG_NF_TABLES_INET=y
CONFIG_NFT_COMPAT=m
CONFIG_NFT_CT=m
CONFIG_NFT_LIMIT=m
CONFIG_NFT_LOG=m
CONFIG_NFT_REJECT=m
CONFIG_IP_NF_IPTABLES=m
CONFIG_IP6_NF_IPTABLES=m
CONFIG_IP_NF_TARGET_REJECT=m
CONFIG_IP6_NF_TARGET_REJECT=m
CONFIG_NETFILTER_XT_TARGET_LOG=m
CONFIG_NETFILTER_XT_MATCH_ADDRTYPE=m
CONFIG_NETFILTER_XT_MATCH_CONNTRACK=m
CONFIG_NETFILTER_XT_MATCH_LIMIT=m
CONFIG_NETFILTER_XT_MATCH_RECENT=m
CONFIG_NETFILTER_XT_MATCH_MULTIPORT=m
CONFIG_NETFILTER_XT_MATCH_PKTTYPE=m
CONFIG_NETFILTER_XT_MATCH_HL=m
CONFIG_IP6_NF_MATCH_RT=m

# Omarchy's Docker bridge networking and storage.
CONFIG_NAMESPACES=y
CONFIG_NET_NS=y
CONFIG_CGROUPS=y
CONFIG_VETH=m
CONFIG_BRIDGE=m
CONFIG_BRIDGE_NETFILTER=m
CONFIG_OVERLAY_FS=m
CONFIG_NF_NAT=m
CONFIG_NFT_NAT=m
CONFIG_NFT_MASQ=m
CONFIG_NFT_REDIR=m
CONFIG_NETFILTER_XT_NAT=m
CONFIG_NETFILTER_XT_TARGET_MASQUERADE=m

# Keep diagnostics in the ring buffer without flooding the setup terminal.
CONFIG_CONSOLE_LOGLEVEL_DEFAULT=3
CONFIG_CONSOLE_LOGLEVEL_QUIET=3

# Internal speakers and accelerated graphics are not supported by this V1.
# CONFIG_SND_SOC_APPLE_MACAUDIO is not set
# CONFIG_DRM_ASAHI is not set

# Pacman, systemd and namespace-based application sandboxes.
CONFIG_SECURITY=y
CONFIG_SECURITYFS=y
CONFIG_SECURITY_LANDLOCK=y
CONFIG_LSM="landlock,lockdown,yama,loadpin,safesetid,ipe,bpf"
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y
CONFIG_USER_NS=y
CONFIG_PID_NS=y
CONFIG_IPC_NS=y
CONFIG_UTS_NS=y
CONFIG_CGROUP_PIDS=y
CONFIG_MEMCG=y
CONFIG_CGROUP_BPF=y
CONFIG_BPF_SYSCALL=y
CONFIG_FHANDLE=y
CONFIG_SIGNALFD=y
CONFIG_TIMERFD=y
CONFIG_EVENTFD=y
CONFIG_EPOLL=y
CONFIG_INOTIFY_USER=y
CONFIG_POSIX_MQUEUE=y

# iwd requests this parser for private keys used by EAP authentication.
CONFIG_PKCS8_PRIVATE_KEY_PARSER=m

# Shared M4/J713 and Neo/J700 kernel: retain the M4 drivers above.
CONFIG_NR_CPUS=64
CONFIG_ARM64_PA_BITS_48=y
CONFIG_MT7932_FULLMAC=y
CONFIG_CFG80211=y
CONFIG_RFKILL=y
CONFIG_PHY_APPLE_J700_REPEATER=y
CONFIG_TYPEC_SN201202X=y
CONFIG_USB_DWC3_APPLE=y
CONFIG_USB_DWC3_HOST=y
CONFIG_MFD_MACSMC=y
CONFIG_GPIO_MACSMC=y
CONFIG_MACSMC_POWER=y
CONFIG_POWER_RESET_MACSMC=y
CONFIG_SENSORS_MACSMC_HWMON=y
CONFIG_POWER_SUPPLY_HWMON=y
CONFIG_ARM_APPLE_SOC_CPUFREQ=y
CONFIG_APPLE_SMC_CPU_THERMAL=y
CONFIG_APPLE_PMP_V2=y
CONFIG_APPLE_PMP_V2_THERMAL=y
CONFIG_HID_DOCKCHANNEL=y
CONFIG_HID_MAGICMOUSE=y
CONFIG_HID_APPLE=y
CONFIG_HID_GENERIC=y
CONFIG_SERIAL_SAMSUNG=y
CONFIG_SERIAL_SAMSUNG_CONSOLE=y
# Neo has no drained DMA handoff to a replacement kernel.
# CONFIG_KEXEC is not set
# CONFIG_KEXEC_FILE is not set
# CONFIG_CRASH_DUMP is not set
